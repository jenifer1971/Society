# ============================================================
# Society — LLM Configuration
# ============================================================

LLM_PROVIDER=gemini
LLM_MODEL_NAME=

# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.0-flash


# ============================================================
# DATABASE — PostgreSQL + pgvector
# ============================================================
POSTGRES_DSN=postgresql://society:society@postgres:5432/society


# ============================================================
# APPLICATION
# ============================================================
SECRET_KEY=change-me-in-production
FLASK_DEBUG=false

# Simulation tuning (optional)
OASIS_DEFAULT_MAX_ROUNDS=10
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5

# Temporal fact tracking (optional — costs one extra LLM call per activity batch)
ENABLE_TEMPORAL_TRACKING=false

# LLM reranking (optional — costs one extra LLM call per search query)
ENABLE_LLM_RERANKING=false
