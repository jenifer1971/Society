# ============================================================
# Society — Enterprise LLM Configuration
# Copy this file to .env and fill in the values for your
# organisation's subscribed cloud provider.
# ============================================================

# ── Select your LLM provider ─────────────────────────────────────────────────
# One of: openai | azure_openai | gemini | anthropic | bedrock | ollama
LLM_PROVIDER=openai

# ── Optional: override the model name for the selected provider ───────────────
# If left blank, the provider default below is used.
LLM_MODEL_NAME=


# ============================================================
# PROVIDER SETTINGS — fill in the section matching LLM_PROVIDER
# ============================================================

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Ollama (local / on-prem, no key needed) ───────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3


# ============================================================
# DATABASE — PostgreSQL + pgvector (knowledge graph & agent memory)
# When running via docker-compose this is set automatically.
# For local development point at your own postgres instance.
# ============================================================
POSTGRES_DSN=postgresql://society:society@localhost:5432/society


# ============================================================
# APPLICATION
# ============================================================
SECRET_KEY=change-me-in-production
FLASK_DEBUG=false

# Simulation tuning (optional)
OASIS_DEFAULT_MAX_ROUNDS=10
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
